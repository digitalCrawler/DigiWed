# ---------------------------------------------------------------------------
# Copy to .env.local and fill in. Everything here is optional: the site runs
# without any of it, using the defaults in lib/site.ts.
# ---------------------------------------------------------------------------

# Canonical origin — drives canonical tags, og:url, JSON-LD, sitemap.xml and
# robots.txt. MUST be https, with no trailing slash. (A http:// value is
# rewritten to https:// for any non-local host, so the two never disagree.)
NEXT_PUBLIC_SITE_URL=https://digiweds.syfiz.in

# Brand name shown in the header, footer, titles and structured data
NEXT_PUBLIC_SITE_NAME=DigiWeds
NEXT_PUBLIC_SITE_SHORT_NAME=DigiWeds

# Google AdSense. The publisher id already defaults to the real one in
# lib/site.ts, so this only needs setting to override it. The footer slot id
# comes from a display ad unit you create after approval — until it is set the
# script still loads but the bottom strip stays empty.
# NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-1369117380461310
NEXT_PUBLIC_ADSENSE_FOOTER_SLOT=

# Donations (UPI) — your own VPA; the Pay button and QR appear once this is set
NEXT_PUBLIC_UPI_ID=yourname@upi
NEXT_PUBLIC_UPI_NAME=DigiWeds

# A mailbox you actually read — shown on contact, privacy and terms.
# AdSense and Search Console both expect a working contact route.
NEXT_PUBLIC_CONTACT_EMAIL=hello@digiweds.syfiz.in

# Optional, only if you have one
NEXT_PUBLIC_TWITTER=
