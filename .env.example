# Public site URL (used for canonical URLs, sitemap and JSON-LD)
NEXT_PUBLIC_SITE_URL=https://www.shaadicardstudio.in

# Google AdSense — leave blank until your account is approved
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX
NEXT_PUBLIC_ADSENSE_FOOTER_SLOT=1234567890

# Donations (UPI) — your own VPA; the Pay button and QR appear once this is set
NEXT_PUBLIC_UPI_ID=yourname@upi
NEXT_PUBLIC_UPI_NAME=Your Name

# Shown on the contact / privacy pages
NEXT_PUBLIC_CONTACT_EMAIL=hello@shaadicardstudio.in
